{
  "name": "nuxt-template",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently \"nuxt dev\" \"prisma studio\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:reset": "prisma migrate reset -f && prisma migrate dev  && prisma generate && prisma db seed"
  },
  "dependencies": {
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.11.0",
    "@types/nodemailer": "^7.0.4",
    "better-auth": "1.6.23",
    "dotenv": "^17.2.3",
    "file-type": "^22.0.2",
    "nodemailer": "^7.0.11",
    "nuxt": "^4.3.1",
    "vue": "^3.5.25",
    "vue-router": "^5.2.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
